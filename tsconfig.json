{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@ciaui/core",
    "types": ["@webgpu/types"],
    "paths": {
      "@ciaui/core": ["./packages/core/src/index.ts"],
      "@ciaui/render-webgpu": ["./packages/render-webgpu/src/index.ts"],
      "@ciaui/render-dom": ["./packages/render-dom/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "examples/*/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
