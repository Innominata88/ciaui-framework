{
  "name": "ciaui-framework",
  "version": "0.0.1",
  "private": true,
  "description": "WebGPU-native, WebXR-first adaptive UI framework",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=examples/hello-world",
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf packages/*/dist examples/*/dist node_modules/.cache"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.40",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ciaui-framework"
  },
  "license": "MIT"
}
